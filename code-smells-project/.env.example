# Copie para .env (ou exporte no shell) e ajuste. Nenhum valor aqui é segredo real.

# Segredo do Flask. Sem valor, um aleatório é gerado a cada boot.
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO
APP_ENV=producao

# Banco SQLite
DATABASE_PATH=loja.db

# Origens liberadas para CORS, separadas por vírgula. Vazio = CORS desligado (só mesma origem).
CORS_ORIGINS=

# Token exigido no header X-Admin-Token pelas rotas privilegiadas. Vazio = rotas sempre bloqueadas.
ADMIN_TOKEN=

# Operações perigosas: além do token, precisam ser habilitadas explicitamente.
ENABLE_ADMIN_QUERY=false
ENABLE_ADMIN_RESET=false

# Senha do usuário admin@loja.com criado pelo seed. Vazio = senha aleatória.
SEED_ADMIN_PASSWORD=
