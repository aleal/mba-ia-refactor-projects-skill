# Porta HTTP (default: 3000)
PORT=3000
# Caminho do banco SQLite (default: :memory:, recriado e populado a cada boot)
DB_PATH=:memory:
# Token exigido no header X-Admin-Token das rotas administrativas.
# Vazio = rotas administrativas sempre bloqueadas.
ADMIN_TOKEN=
# Chave do gateway de pagamento
PAYMENT_GATEWAY_KEY=
# debug | info | warn | error
LOG_LEVEL=info
