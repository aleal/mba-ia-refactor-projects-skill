# Chave de assinatura dos tokens. Obrigatória em produção (gere com: python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=
# Validade do token de login, em segundos (padrão: 8h)
TOKEN_MAX_AGE=28800

DATABASE_URL=sqlite:///tasks.db

FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Envio de e-mail desligado por padrão: com false, as notificações só vão para o log
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
